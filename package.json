{
  "name": "lineage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A company brain for an open-source project: people, PRs, issues and files in FalkorDB, with an agent that shows the path behind every answer.",
  "scripts": {
    "fetch": "node --import tsx src/github/fetch.ts",
    "load": "node --import tsx src/graph/load.ts",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "node --import tsx --test src/agent/validate.test.ts",
    "ask": "node --env-file=.env --import tsx src/ask.ts"
  },
  "dependencies": {
    "falkordb": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
